{
  // docs.mlaify.io — Hugo + Pagefind, served as Workers static assets.
  //
  // There is deliberately no `main` and no Worker script. With `assets` and no
  // `main`, requests are served entirely by Cloudflare's asset worker: no
  // Worker invocation, no per-request cost, nothing to keep warm.
  //
  // Deployed only by .github/workflows/deploy.yml after the operator approves
  // the `production` environment. Workers Builds builds every push and only
  // uploads a version. See README.md "Deploy".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-mlaify-io",
  "compatibility_date": "2026-07-28",

  "assets": {
    "directory": "./public",

    // Hugo emits public/<path>/index.html, so /install must redirect to
    // /install/. This reproduces what GitHub Pages did implicitly and what
    // LiteSpeed's DirectorySlash did on InterServer.
    "html_handling": "auto-trailing-slash",

    // Hugo builds public/404.html. This serves it with a real 404 status.
    // Must NOT be "single-page-application" — that would return 200 for every
    // missing path and let soft-404s into the index.
    "not_found_handling": "404-page"
  },

  // docs.fhrp.org, docs.mldavis.me, and docs.tffhrtp.org serve the same docs
  // directly (not redirects) because some services refuse to follow them;
  // canonical URLs still point at docs.mlaify.io. They must be listed here —
  // `wrangler deploy` replaces any domains attached in the dashboard.
  // docs.matthewd.xyz was dropped on 2026-11-08 (operator): matthewd.xyz is the
  // personal site now. The next deploy detaches it from this Worker.
  "routes": [
    {
      "pattern": "docs.mlaify.io",
      "custom_domain": true
    },
    {
      "pattern": "docs.fhrp.org",
      "custom_domain": true
    },
    {
      "pattern": "docs.mldavis.me",
      "custom_domain": true
    },
    {
      "pattern": "docs.tffhrtp.org",
      "custom_domain": true
    }
  ],

  // No <name>.workers.dev hostname for production — the docs are only
  // reachable at their custom domain, so there is no unbranded duplicate for
  // crawlers to find. Preview URLs are off too: non-production branches still
  // build and upload a version, but it gets no public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }
}
