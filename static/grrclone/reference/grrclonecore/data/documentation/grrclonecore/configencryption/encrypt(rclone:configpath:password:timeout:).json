h this would wait on","type":"text"},{"text":" ","type":"text"},{"text":"forever — is terminated and reported instead (#118).","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigEncryption\/encrypt(rclone:configPath:password:timeout:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grrclonecore\/configencryption\/encrypt(rclone:configpath:password:timeout:)"]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConfigEncryption":{"kind":"symbol","abstract":[{"type":"text","text":"Turning on encryption for "},{"type":"codeVoice","code":"rclone.conf"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConfigEncryption","kind":"identifier"}],"navigatorTitle":[{"text":"ConfigEncryption","kind":"identifier"}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigEncryption","url":"\/documentation\/grrclonecore\/configencryption","role":"symbol","title":"ConfigEncryption"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConfigEncryption/encrypt(rclone:configPath:password:timeout:)":{"type":"topic","url":"\/documentation\/grrclonecore\/configencryption\/encrypt(rclone:configpath:password:timeout:)","role":"symbol","title":"encrypt(rclone:configPath:password:timeout:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encrypt","kind":"identifier"},{"text":"(","kind":"text"},{"text":"rclone","kind":"externalParam"},{"text":": ","kind":"text"},{"te