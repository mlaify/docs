pe":"text","text":" directory of "},{"code":"dav1","type":"codeVoice"},{"type":"text","text":". Verified directly —"},{"type":"text","text":" "},{"code":"rclone lsf \"loc:\/tmp\/x\/reports:2026\"","type":"codeVoice"},{"type":"text","text":" lists that directory’s contents. A"},{"type":"text","text":" "},{"type":"text","text":"backend that allows a colon in a directory name is entitled to have one, and"},{"type":"text","text":" "},{"type":"text","text":"silently stripping it mounted somewhere else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trimmed rather than refused: none of these is worth rejecting the input over,"},{"type":"text","text":" "},{"type":"text","text":"and the caller shows what was actually saved."}]}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/Connection/sanitisedPath(_:)":{"abstract":[{"text":"Keep a subpath usable as the right-hand side of ","type":"text"},{"code":"remote:path","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/grrclonecore\/connection\/sanitisedpath(_:)","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sanitisedPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/Connection\/sanitisedPath(_:)","title":"sanitisedPath(_:)","role":"symbol"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/Connection":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" 