{"sections":[],"abstract":[{"type":"text","text":"Clean up mounts left behind by a previous run that did not shut down cleanly."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcileOrphans"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/ReconcileReport","preciseIdentifier":"s:12GrrCloneCore17ConnectionManagerC15ReconcileReportV","text":"ReconcileReport"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Scoped strictly to paths recorded in "},{"type":"codeVoice","code":"MountRegistry"},{"type":"text","text":". The live mount table is"},{"type":"text","text":" "},{"type":"text","text":"consulted only to check whether a path we already know we own is still mounted."},{"type":"text","text":" "},{"type":"text","text":"This matters because a user’s own "},{"type":"codeVoice","code":"rclone nfsmount"},{"type":"text","text":" appears in "},{"type":"codeVoice","code":"mount(8)"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"as ours does — same "},{"type":"codeVoice","code":"localhost:\/"},{"type":"text","text":" source, same owner — so any scan that decided"},{"type":"text","text":" "},{"type":"text","text":"ownership from the mount table would force-unmount the user’s volumes, possibly"},{"type":"text","text":" "},{"type":"text","text":"mid-write. Ownership comes from our own records or not at all."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:12GrrCloneCore17ConnectionManagerC16reconcileOrphansAC15ReconcileReportVyYaKF","modules":[{"name":"GrrCloneCo