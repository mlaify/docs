{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grrclonecore\/connectionmanager\/shutdown(draintimeout:deadline:onprogress:)"]}],"metadata":{"title":"shutdown(drainTimeout:deadline:onProgress:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shutdown","kind":"identifier"},{"text":"(","kind":"text"},{"text":"drainTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":", ","kind":"text"},{"text":"deadline","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":"?, ","kind":"text"},{"text":"onProgress","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"ShutdownOutcome","kind":"typeIdentifier","preciseIdentifier":"s:12GrrCloneCore17ConnectionManagerC15ShutdownOutcomeV"}],"modules":[{"name":"GrrCloneCore"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:12GrrCloneCore17ConnectionManagerC8shutdown12drainTimeout8deadline10onProgressAC15ShutdownOutcomeVSd_SdSgySiYbcSgtYaF"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager"]]},"sections":[],"abstract":[{"text":"Ordered teardown for app quit, bounded by a deadline it enforces itself.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/shutdown(drainTimeout:deadline:onProgress:)"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shutdown"},{"kind":"text","text":"("},{"kind":"externalParam","text":"drainTimeout"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier","text":"TimeInterval"},{"kind":"text","text":" = 0, "},{"kind":"externalParam","text":"deadline"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"onProgress","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"ShutdownOutcome","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/ShutdownOutcome","preciseIdentifier":"s:12GrrCloneCore17ConnectionManagerC15ShutdownOutcomeV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"drainTimeout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Seconds to wait for uploads. Pass 0 to skip waiting."}]}]},{"name":"deadline","content":[{"inlineContent":[{"type":"text","text":"Total seconds for everything. Defaults to the full budget."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Order is not interchangeable. Uploads drain first, because quitting with writes"},{"type":"text","text":" "},{"type":"text","text":"still queued strands the only copy of a file in a local cache. Mounts come down"},{"type":"text","text":" "},{"type":"text","text":"next. The daemon dies last, because killing rclone under a live NFS mount leaves"},{"type":"text","text":" "},{"type":"text","text":"the kernel talking to a dead server and hangs Finder until the mount is forcibly"},{"type":"text","text":" "},{"type":"text","text":"removed."}]},{"type":"paragraph","inlineContent":[{"text":"The deadline is enforced here rather than by a watchdog in the caller. An","type":"text"},{"text":" ","type":"text"},{"text":"external timer that fires mid-teardown kills the process between unmounting and","type":"text"},{"text":" ","type":"text"},{"text":"stopping the daemon, which is the one state this ordering exists to avoid. When","type":"text"},{"text":" ","type":"text"},{"text":"time runs out, the remaining mounts are deliberately left up ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and the daemon is"},{"type":"text","text":" "},{"type":"text","text":"left running to serve them"}]},{"text":" — an orphan the next launch reaps and reconciles,","type":"text"},{"text":" ","type":"text"},{"text":"which is strictly safer than a live mount with no server behind it.","type":"text"}]}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConnectionManager","kind":"identifier"}],"navigatorTitle":[{"text":"ConnectionManager","kind":"identifier"}],"title":"ConnectionManager","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/grrclonecore\/connectionmanager","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager","abstract":[{"text":"Owns the lifecycle of every connection: start the daemon, serve, mount, unmount,","type":"text"},{"text":" ","type":"text"},{"text":"reconcile after a crash, and tear down in the one order that is safe.","type":"text"}]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager/ShutdownOutcome":{"role":"symbol","navigatorTitle":[{"text":"ShutdownOutcome","kind":"identifier"}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/ShutdownOutcome","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShutdownOutcome","kind":"identifier"}],"type":"topic","title":"ConnectionManager.ShutdownOutcome","url":"\/documentation\/grrclonecore\/connectionmanager\/shutdownoutcome","abstract":[]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager/shutdown(drainTimeout:deadline:onProgress:)":{"kind":"symbol","url":"\/documentation\/grrclonecore\/connectionmanager\/shutdown(draintimeout:deadline:onprogress:)","abstract":[{"type":"text","text":"Ordered teardown for app quit, bounded by a deadline it enforces itself."}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/shutdown(drainTimeout:deadline:onProgress:)","role":"symbol","title":"shutdown(drainTimeout:deadline:onProgress:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shutdown","kind":"identifier"},{"text":"(","kind":"text"},{"text":"drainTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"deadline","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"onProgress","kind":"externalParam"},{"text":": ((","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12GrrCloneCore17ConnectionManagerC15ShutdownOutcomeV","text":"ShutdownOutcome","kind":"typeIdentifier"}]}}}