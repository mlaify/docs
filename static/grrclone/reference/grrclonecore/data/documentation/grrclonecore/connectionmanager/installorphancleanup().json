{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/grrclonecore\/connectionmanager\/installorphancleanup()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"installOrphanCleanup()","externalID":"s:12GrrCloneCore17ConnectionManagerC20installOrphanCleanupyyYaF","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"GrrCloneCore"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"installOrphanCleanup","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager"]]},"identifier":{"url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/installOrphanCleanup()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Teach the supervisor to bring our mounts down before it kills an orphaned","type":"text"},{"text":" ","type":"text"},{"text":"daemon.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"installOrphanCleanup","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call once, after construction and before the first "},{"code":"start()","type":"codeVoice"},{"type":"text","text":". Without it the"},{"type":"text","text":" "},{"type":"text","text":"supervisor kills the orphan out from under live mounts and the kernel is left"},{"type":"text","text":" "},{"type":"text","text":"talking to a dead NFS server. It is wired here rather than left to each caller"},{"type":"text","text":" "},{"type":"text","text":"because "},{"code":"start()","type":"codeVoice"},{"type":"text","text":" is reached from a dozen places and one missed call site"},{"type":"text","text":" "},{"type":"text","text":"reintroduces the bug silently."}]},{"type":"paragraph","inlineContent":[{"text":"Weak so the supervisor holding this closure does not keep the manager alive.","type":"text"}]}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager/installOrphanCleanup()":{"url":"\/documentation\/grrclonecore\/connectionmanager\/installorphancleanup()","abstract":[{"type":"text","text":"Teach the supervisor to bring our mounts down before it kills an orphaned"},{"type":"text","text":" "},{"type":"text","text":"daemon."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"installOrphanCleanup"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"title":"installOrphanCleanup()","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/installOrphanCleanup()","kind":"symbol"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConnectionManager","kind":"identifier"}],"navigatorTitle":[{"text":"ConnectionManager","kind":"identifier"}],"title":"ConnectionManager","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/grrclonecore\/connectionmanager","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager","abstract":[{"text":"Owns the lifecycle of every connection: start the daemon, serve, mount, unmount,","type":"text"},{"text":" ","type":"text"},{"text":"reconcile after a crash, and tear down in the one order that is safe.","type":"text"}]}}}