er"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"connection","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/Connection","text":"Connection","kind":"typeIdentifier","preciseIdentifier":"s:12GrrCloneCore10ConnectionV"},{"text":", ","kind":"text"},{"text":"configPath","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"force"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":" = false) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"DeletionOutcome","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/DeletionOutcome","preciseIdentifier":"s:12GrrCloneCore17ConnectionManagerC15DeletionOutcomeV"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"Skip only the pending-upload refusal, for a user who has","type":"text"},{"text":" ","type":"text"},{"text":"been shown the list and chosen to discard it. Nothing else is skippable.","type":"text"}],"type":"paragraph"}],"name":"force"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The order is the same one every other teardown path in this type uses, for the","type":"text"},{"text":" ","type":"text"},{"text":"same reasons, and it is not interchangeable:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Refuse if anything is still uploading."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"--vfs-cache-mode full"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"type":"text","text":"from a write as soon as the bytes are on local disk, so the cache can hold"},{"type":"text","text":" "},{"type":"text","text":"the only copy of a file. This is the step that protects the user’s own work,"},{"type":"text","text":" "},{"type":"text","text":"and it fails closed: a cache that cannot be read counts as “unknown”, not"},{"type":"text","text":" "},{"type":"text","text":"“empty”."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unmount, then stop the server"}],"type":"strong"},{"text":" — via ","type":"text"},{"code":"disconnect","type":"codeVoice"},{"text":", rather than","type":"text"},{"text":" ","type":"text"},{"text":"reimplemented here. Stopping the server first leaves the kernel talking to a","type":"text"},{"text":" ","type":"text"},{"text":"dead NFS server and hangs Finder.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Back up "},{"type":"codeVoice","code":"rclone.conf"},{"type":"text","text":"."}]},{"type":"text","text":" Taken here and not earlier: nothing above this"},{"type":"text","text":" "},{"type":"text","text":"line writes to that file, so an earlier copy would only litter backups for"},{"type":"text","text":" "},{"type":"text","text":"deletions that were refused."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Delete the remote","type":"text"}]},{"type":"text","text":", then the local cache."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"The keychain is deliberately untouched. It holds the password for the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"configuration file"}],"type":"emphasis"},{"text":", keyed by config path — not this remote’s credentials.","type":"text"},{"text":" ","type":"text"},{"text":"Removing it because the last remote went away would lock the user out of a","type":"text"},{"text":" ","type":"text"},{"text":"config they still have. See #56.","type":"text"}]}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/Connection":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Connection","kind":"identifier"}],"abstract":[{"type":"text","text":"A remote the user has configured for mounting, plus how they want it mounted."}],"navigatorTitle":[{"text":"Connection","kind":"identifier"}],"url":"\/documentation\/grrclonecore\/connection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/Connection","kind":"symbol","type":"topic","role":"symbol","title":"Connection"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConnectionManager","kind":"identifier"}],"navigatorTitle":[{"text":"ConnectionManager","kind":"identifier"}],"title":"ConnectionManager","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/grrclonecore\/connectionmanager","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager","abstract":[{"text":"Owns the lifecycle of every connection: start the daemon, serve, mount, unmount,","type":"text"},{"text":" ","type":"text"},{"text":"reconcile after a crash, and tear down in the one order that is safe.","type":"text"}]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/ConnectionManager/DeletionOutcome":{"type":"topic","abstract":[],"title":"ConnectionManager.DeletionOutcome","url":"\/documentation\/grrclonecore\/connectionmanager\/deletionoutcome","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConnectionManager\/DeletionOutcome","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeletionOutcome"}],"navigatorTitle":[{"kind":"identifier","text":"DeletionO