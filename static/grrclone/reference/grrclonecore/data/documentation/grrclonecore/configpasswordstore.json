{"topicSections":[{"identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/init(configPath:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/hasSavedPassword"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/forget()","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/load()","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/save(_:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/service"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"},{"identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/ConfigPasswordStore\/Failure"],"anchor":"Enumerations","generated":true,"title":"Enumerations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grrclonecore\/configpasswordstore"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConfigPasswordStore","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"The password is the key to every remote the user has configured, so what this does"},{"type":"text","text":" "},{"type":"text","text":"and does not protect is worth stating precisely."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"It uses the legacy file-based keychain, deliberately."}],"type":"strong"},{"text":" The modern data protection","type":"text"},{"text":" ","type":"text"},{"text":"keychain — the one that honours ","type":"text"},{"code":"kSecAttrAccessible","type":"codeVoice"},{"text":" — requires the","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement, and a Developer ID app distributed outside the","type":"text"},{"text":" ","type":"text"},{"text":"App Store cannot carry that without an embedded provisioning profile. Measured, not","type":"text"},{"text":" ","type":"text"},{"text":"assumed: ","type":"text"},{"code":"SecItemAdd","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"kSecUseDataProtectionKeychain","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"-34018","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"“a required entitlement is not present”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That has a consequence worth being honest about. An earlier version of this file set"},{"type":"text","text":" "},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" and claimed in a comment that the"},{"type":"text","text":" "},{"type":"text","text":"password was unreadable while the Mac was locked. "},{"type":"strong","inlineContent":[{"text":"It was not.","type":"text"}]},{"type":"text","text":" The legacy keychain"},{"type":"text","text":" "},{"type":"text","text":"silently ignores the attribute — reading the item back showed no "},{"type":"codeVoice","code":"pdmn"},{"text":" attribute at","type":"text"},{"text":" ","type":"text"},{"text":"all — so the claim was false and the protection imaginary. The item is protected by","type":"text"},{"text":" ","type":"text"},{"text":"the login keychain, which is unlocked for the whole login session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What is true:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encrypted at rest"}]},{"type":"text","text":" in the login keychain, not in a preferences file."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Never synchronised."}],"type":"strong"},{"text":" iCloud Keychain covers only data protection keychain items,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"kSecAttrSynchronizable"},{"text":" is set to false explicitly rather than left to a","type":"text"},{"text":" ","type":"text"},{"text":"default that could change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Keyed by config path","type":"text"}],"type":"strong"},{"text":", so pointing grrclone at a different config gets a","type":"text"},{"text":" ","type":"text"},{"text":"different item instead of silently reusing a password that cannot work.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Saving is always the user’s choice. Nothing is written unless they ask, and ","type":"text"},{"code":"forget","type":"codeVoice"},{"text":" ","type":"text"},{"text":"makes the choice reversible without opening Keychain Access.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore"]]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/docs.GrrCloneCore\/s8SendableP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"metadata":{"roleHeading":"Structure","externalID":"s:12GrrCloneCore19ConfigPasswordStoreV","modules":[{"name":"GrrCloneCore"}],"title":"ConfigPasswordStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConfigPasswordStore"}],"navigatorTitle":[{"kind":"identifier","text":"ConfigPasswordStore"}],"role":"symbol","symbolKind":"struct"},"abstract":[{"text":"Stores the pass