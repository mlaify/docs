{"hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport"]]},"metadata":{"externalID":"s:12GrrCloneCore12NFSTransportV21protectWhileUnmountedyy10Foundation3URLVKFZ","symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"protectWhileUnmounted","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","modules":[{"name":"GrrCloneCore"}],"roleHeading":"Type Method","title":"protectWhileUnmounted(_:)"},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport\/protectWhileUnmounted(_:)"},"abstract":[{"text":"Make a mountpoint unwritable while nothing is mounted on it.","type":"text"}],"variants":[{"paths":["\/documentation\/grrclonecore\/nfstransport\/protectwhileunmounted(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"protectWhileUnmounted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"url"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"An empty directory sitting where a volume used to be is a trap: anything","type":"text"},{"text":" ","type":"text"},{"text":"written there lands on the local disk, looks saved, and then disappears the","type":"text"},{"text":" ","type":"text"},{"text":"moment the mount comes back over the top of it. grrclone removes the directory","type":"text"},{"text":" ","type":"text"},{"text":"on a clean disconnect, so the exposure is after a crash or a force quit — which","type":"text"},{"text":" ","type":"text"},{"text":"is exactly when the user is least likely to notice.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"0500"},{"type":"text","text":" closes it, and costs nothing in either direction. Measured against a"},{"type":"text","text":" "},{"type":"text","text":"real rclone NFS server:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"touch"},{"type":"text","text":" inside the empty directory fails with "},{"type":"codeVoice","code":"Permission denied"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"mounting over it still succeeds and the remote lists normally"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"writing ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"through"}]},{"text":" the mount works, because the mounted filesystem’s","type":"text"},{"text":" ","type":"text"},{"text":"permissions come from the server, not from the directory underneath","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"unmounting reverts to the protected directory with no extra work"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Read and execute are kept so the path can still be inspected and so Finder can","type":"text"},{"text":" ","type":"text"},{"text":"show it; only writing is refused.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/NFSTransport/protectWhileUnmounted(_:)":{"abstract":[{"type":"text","text":"Make a mountpoint unwritable while nothing is mounted on it."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport\/protectWhileUnmounted(_:)","title":"protectWhileUnmounted(_:)","url":"\/documentation\/grrclonecore\/nfstransport\/protectwhileunmounted(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"protectWhileUnmounted"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/NFSTransport":{"navigatorTitle":[{"text":"NFSTransport","kind":"identifier"}],"title":"NFSTransport","url":"\/documentation\/grrclonecore\/nfstransport","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Serves the remote over NFS on loopback and mounts it with the built-in NFS client."}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFSTransport","kind":"identifier"}]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"}}}