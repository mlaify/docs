{"sections":[],"abstract":[{"text":"Unmount, and believe only the mount table about whether it worked.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grrclonecore\/nfstransport\/unmount(at:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport\/unmount(at:)"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"mountPoint","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Exit status is not evidence here, in either direction — observed on a real","type":"text"},{"text":" ","type":"text"},{"text":"machine with three NFS mounts stacked on one path (#116):","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"diskutil umount force","type":"codeVoice"},{"text":" exits 0 having removed one layer, so the caller","type":"text"},{"type":"text","text":" "},{"type":"text","text":"forgot the registry entry and ran "},{"type":"codeVoice","code":"removeIfEmpty"},{"type":"text","text":" on the layer underneath,"},{"type":"text","text":" "},{"type":"text","text":"which is still mounted and still ours."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"umount -f"},{"type":"text","text":" prints "},{"type":"codeVoice","code":"Operation timed out"},{"type":"text","text":" and exits non-zero whether or not"},{"type":"text","text":" "},{"type":"text","text":"it removed a layer. It had."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"So each command is followed by a second, independent read of the table, and","type":"text"},{"text":" ","type":"text"},{"text":"that read decides. Success is “nothing mounted there any more”. A layer","type":"text"},{"text":" ","type":"text"},{"text":"removed with another still under it is reported as exactly that, and","type":"text"},{"text":" ","type":"text"},{"text":"thrown, so the caller keeps treating the path as mounted and owned — which it","type":"text"},{"text":" ","type":"text"},{"text":"is. One layer per call, deliberately: the registry records a path once, and","type":"text"},{"text":" ","type":"text"},{"text":"stripping every layer on the strength of that would also strip a volume","type":"text"},{"text":" ","type":"text"},{"text":"something else put there.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An unreadable table is a failure, not a success: a caller that goes on to","type":"text"},{"text":" ","type":"text"},{"text":"forget the record and clean the directory needs to know the path is clear,","type":"text"},{"text":" ","type":"text"},{"text":"and “could not look” is not knowing.","type":"text"}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","externalID":"s:12GrrCloneCore12NFSTransportV7unmount2aty10Foundation3URLV_tYaKF","modules":[{"name":"GrrCloneCore"}],"symbolKind":"method","title":"unmount(at:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport"]]},"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/NFSTransport":{"navigatorTitle":[{"text":"NFSTransport","kind":"identifier"}],"title":"NFSTransport","url":"\/documentation\/grrclonecore\/nfstransport","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Serves the remote over NFS on loopback and mounts it with the built-in NFS client."}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NFSTransport","kind":"identifier"}]},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/NFSTransport/unmount(at:)":{"url":"\/documentation\/grrclonecore\/nfstransport\/unmount(at:)","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/NFSTransport\/unmount(at:)","abstract":[{"type":"text","text":"Unmount, and believe only the mount table about whether it worked."}],"title":"unmount(at:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"}}}