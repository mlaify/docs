{"kind":"symbol","metadata":{"modules":[{"name":"GrrCloneCore"}],"externalID":"s:12GrrCloneCore12InstanceWaitO8deadlineSdvpZ","role":"symbol","roleHeading":"Type Property","title":"deadline","symbolKind":"property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"deadline","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grrclonecore\/instancewait\/deadline"]}],"abstract":[{"text":"Long enough to cover a real teardown.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deadline","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"codeVoice","code":"applicationShouldTerminate"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":".terminateLater"},{"text":" and the quit path can","type":"text"},{"text":" ","type":"text"},{"text":"legitimately run for minutes: up to 120s draining uploads, plus","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NFSTransport.unmountBudget"},{"text":" for each mount, plus the daemon stop. Anything","type":"text"},{"text":" ","type":"text"},{"text":"shorter turns “the old copy is still tidying up” into “the new copy refused","type":"text"},{"text":" ","type":"text"},{"text":"to start”, which is what a user sees after an upgrade.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Derived from the real budgets rather than picked. The first draft said 180,"},{"type":"text","text":" "},{"type":"text","text":"and a test pointed out that a single unmount plus the drain is already 250 —"},{"type":"text","text":" "},{"type":"text","text":"so the new copy would still have refused in precisely the case this exists"},{"type":"text","text":" "},{"type":"text","text":"for. Two unmounts’ worth covers the common two-remote setup with headroom;"},{"type":"text","text":" "},{"type":"text","text":"the wait returns the moment the other copy exits, so the bound is only ever"},{"type":"text","text":" "},{"type":"text","text":"paid when it is genuinely still running."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Bounded, though. An instance wedged forever must not wedge the launch too;"},{"type":"text","text":" "},{"type":"text","text":"after this, refusing is the right answer and the alert explains it."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/InstanceWait"]]},"identifier":{"url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/InstanceWait\/deadline","interfaceLanguage":"swift"},"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/InstanceWait/deadline":{"url":"\/documentation\/grrclonecore\/instancewait\/deadline","kind":"symbol","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/InstanceWait\/deadline","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deadline","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"}],"role":"symbol","title":"deadline","abstract":[{"text":"Long enough to cover a real teardown.","type":"text"}],"type":"topic"},"doc://docs.GrrCloneCor