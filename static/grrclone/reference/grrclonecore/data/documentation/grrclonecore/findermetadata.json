{"topicSections":[{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/FinderMetadata\/writesDSStoreToNetworkVolumes"],"anchor":"Type-Properties"}],"sections":[],"variants":[{"paths":["\/documentation\/grrclonecore\/findermetadata"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore"]]},"kind":"symbol","identifier":{"url":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/FinderMetadata","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"What can and cannot be done about Finder’s metadata files on a remote."}],"metadata":{"title":"FinderMetadata","navigatorTitle":[{"text":"FinderMetadata","kind":"identifier"}],"externalID":"s:12GrrCloneCore14FinderMetadataO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FinderMetadata","kind":"identifier"}],"modules":[{"name":"GrrCloneCore"}],"symbolKind":"enum","roleHeading":"Enumeration","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FinderMetadata"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Two different files, with two different causes, and only one of them fixable."},{"type":"text","text":" "},{"type":"text","text":"Treating them as one problem is why the obvious fixes all failed."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".DS_Store"}],"type":"strong"},{"text":" is written by Finder to record folder view settings. macOS can be","type":"text"},{"text":" ","type":"text"},{"text":"told not to write it to network volumes at all, and an NFS mount counts. Verified:","type":"text"},{"text":" ","type":"text"},{"text":"with the preference set, opening the mount in Finder produced neither the file nor","type":"text"},{"text":" ","type":"text"},{"text":"its sidecar, where before it produced both immediately. That is what this type","type":"text"},{"text":" ","type":"text"},{"text":"exposes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"._name","type":"codeVoice"},{"type":"text","text":" sidecars"}]},{"type":"text","text":" hold extended attributes for filesystems that cannot store"},{"type":"text","text":" "},{"type":"text","text":"them natively. NFSv3 cannot, and rclone serves NFSv3 — "},{"type":"codeVoice","code":"namedattr"},{"type":"text","text":", which would let"},{"type":"text","text":" "},{"type":"text","text":"the server hold them, is NFSv4 only. A sidecar therefore appears for essentially"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file written through the mount: macOS attaches "},{"type":"codeVoice","code":"com.apple.provenance"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"copies, so even a plain text file with no tags and no quarantine flag gets one."},{"type":"text","text":" "},{"type":"text","text":"Measured, not assumed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Those cannot be prevented from here. rclone’s "},{"type":"codeVoice","code":"--no-appledouble"},{"type":"text","text":" is a FUSE mount"},{"type":"text","text":" "},{"type":"text","text":"flag and does not exist on "},{"type":"codeVoice","code":"serve nfs"},{"type":"text","text":", and filters do not help: serving with"},{"type":"text","text":" "},{"type":"codeVoice","code":"--exclude \".DS_Store\" --exclude \"._*\""},{"type":"text","text":" and then writing both still put both on the"},{"type":"text","text":" "},{"type":"text","text":"remote, because filters govern what rclone lists and reads, not what the VFS writes"},{"type":"text","text":" "},{"type":"text","text":"back. Removing them afterwards is a job for rclone itself; see docs\/progress.md."}],"type":"paragraph"}]}],"references":{"doc://docs.GrrCloneCore/documentation/GrrCloneCore/FinderMetadata":{"abstract":[{"type":"text","text":"What can and cannot be done about Finder’s metadata files on a remote."}],"kind":"symbol","type":"topic","url":"\/documentation\/grrclonecore\/findermetadata","navigatorTitle":[{"text":"FinderMetadata","kind":"identifier"}],"role":"symbol","title":"FinderMetadata","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FinderMetadata","kind":"identifier"}],"identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/FinderMetadata"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore":{"title":"GrrCloneCore","type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore","url":"\/documentation\/grrclonecore"},"doc://docs.GrrCloneCore/documentation/GrrCloneCore/FinderMetadata/writesDSStoreToNetworkVolumes":{"title":"writesDSStoreToNetworkVolumes","type":"topic","url":"\/documentation\/grrclonecore\/findermetadata\/writesdsstoretonetworkvolumes","kind":"symbol","identifier":"doc:\/\/docs.GrrCloneCore\/documentation\/GrrCloneCore\/FinderMetadata\/writesDSStoreToNetworkVolumes","abstract":[{"type":"text","text":"Whether macOS is currently configured to write "},{"type":"codeVoice","code":".DS_Store"},{"type":"text","text":" to network volumes."}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writesDSStoreToNetworkVolumes","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]}}}