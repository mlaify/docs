# Redirects for Workers static assets.
#
# Hugo copies static/ verbatim into public/, so this lands at public/_redirects,
# which Cloudflare reads at deploy time; it is not served. Redirects run before
# _headers and before asset lookup, on every hostname this Worker serves.
# Format: [source] [destination] [code]. Limits: 2,000 static and 100 dynamic
# rules; static rules must come before dynamic ones.
#
# docs.mlaify.io was AttackMap-only (MkDocs) until 2026-11; its pages moved under
# /attackmap/. Each is listed with and without the trailing slash, because a
# rule matches the path exactly and these run before the trailing-slash
# redirect. Heading anchors are unchanged, and the browser keeps them across a
# redirect. scripts/check-redirects.sh checks every old URL in
# scripts/old-urls.txt lands on a page. Never remove these rules.

# Static rules
/install /attackmap/install/ 301
/install/ /attackmap/install/ 301
/quickstart /attackmap/quickstart/ 301
/quickstart/ /attackmap/quickstart/ 301
/scanning /attackmap/scanning/ 301
/scanning/ /attackmap/scanning/ 301
/analyzers /attackmap/analyzers/ 301
/analyzers/ /attackmap/analyzers/ 301
/llm /attackmap/llm/ 301
/llm/ /attackmap/llm/ 301
/ci /attackmap/ci/ 301
/ci/ /attackmap/ci/ 301
/gui /attackmap/gui/ 301
/gui/ /attackmap/gui/ 301
/cli /attackmap/cli/ 301
/cli/ /attackmap/cli/ 301
/feature-availability /attackmap/feature-availability/ 301
/feature-availability/ /attackmap/feature-availability/ 301
/sdk /attackmap/sdk/ 301
/sdk/ /attackmap/sdk/ 301

# Dynamic rules: the screenshots (linked from the AttackMap README and mlaify.io).
/img/* /attackmap/img/:splat 301
